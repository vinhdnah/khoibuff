# SUPABASE CONFIGURATION
# Nhận từ Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# =============================================================
# SMM PROVIDER CONFIGURATION
# =============================================================
# Bật true để dùng Mock Provider giả lập khi phát triển
VITE_MOCK_PROVIDER=true

# --- CHỈ DÙNG CHO LOCAL DEV (VITE_ bị bundle vào JS, không dùng cho production) ---
# Trong production, set các biến KHÔNG có tiền tố VITE_ trong Vercel Dashboard
VITE_SMM_PROVIDER_API_URL=https://tangliketym.click/api/v2
VITE_SMM_PROVIDER_API_KEY=your-dev-api-key-only

# --- SERVER-SIDE (Vercel Dashboard -> Environment Variables) ---
# Các biến này KHÔNG bao giờ bị expose ra JS bundle
SMM_PROVIDER_API_URL=https://tangliketym.click/api/v2
SMM_PROVIDER_API_KEY=your-production-api-key

# PAYMENT GATEWAY
VITE_SEPAY_API_KEY=your-sepay-api-key
VITE_SEPAY_BANK_NAME=MBBank
VITE_SEPAY_BANK_ACCOUNT=your-bank-account
VITE_SEPAY_ACCOUNT_HOLDER=YOUR NAME
