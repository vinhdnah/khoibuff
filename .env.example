# SUPABASE CONFIGURATION
# Nhận từ Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# SMM PROVIDER CONFIGURATION (Abstraction)
# Bật true để dùng Mock Provider giả lập khi phát triển / kiểm thử
VITE_MOCK_PROVIDER=true
SMM_PROVIDER_API_URL=https://justanotherpanel.com/api/v2
SMM_PROVIDER_API_KEY=your-external-provider-api-key

# PAYMENT GATEWAY & WEBHOOK SECRETS
PAYMENT_WEBHOOK_SECRET=your-webhook-secret-token
VIETQR_BANK_ACCOUNT=1029384756
VIETQR_BANK_NAME=MBBANK
